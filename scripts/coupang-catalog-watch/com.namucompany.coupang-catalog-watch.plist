<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  쿠팡 결합(노출상품ID) 변동 감지 — ~/Downloads 가 바뀔 때마다 run.ts --send 실행 (처리한 날짜는 다시 안 함).
  등록은 대표 확인 후에만:
    npx tsx scripts/coupang-catalog-watch/run.ts --init     (옛 윙 파일을 처리함으로 기록)
    cp scripts/coupang-catalog-watch/com.namucompany.coupang-catalog-watch.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.namucompany.coupang-catalog-watch.plist
  해제: launchctl unload ~/Library/LaunchAgents/com.namucompany.coupang-catalog-watch.plist
  로그: ~/.namu-catalog-watch/run.log · launchd.err
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.namucompany.coupang-catalog-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/Documents/GitHub/namu-dashboard-new" &amp;&amp; npx --yes tsx scripts/coupang-catalog-watch/run.ts --send</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>/Users/huguoh/Downloads</string>
  </array>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/huguoh/.namu-catalog-watch/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/huguoh/.namu-catalog-watch/launchd.err</string>
</dict>
</plist>
