<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  16GB 크롤링 맥 전용 — 매일 08:45 run-daily-catalog.sh (윙 쿠팡상품정보 받기 → 결합 감시 비교·슬랙).
  24GB 의 com.namucompany.coupang-catalog-watch(09:30·Downloads 감시)와는 별개. 24GB 것은 그대로 둔다 (같은 날짜는 Supabase 확인으로 한 번만 처리).
  등록 (16GB 에서, 대표 확인 후):
    cp ~/crawler/dashboard/scripts/crawler-16gb/com.namucompany.crawler-wing-catalog.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.namucompany.crawler-wing-catalog.plist
  해제: launchctl bootout gui/$(id -u)/com.namucompany.crawler-wing-catalog
  로그: ~/crawler/logs/run-daily.log (요약) · ~/crawler/logs/wing-catalog-YYYY-MM-DD.log · ~/crawler/logs/launchd-wing.err
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.namucompany.crawler-wing-catalog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>"$HOME/crawler/dashboard/scripts/crawler-16gb/run-daily-catalog.sh" &gt;&gt; "$HOME/crawler/logs/launchd-wing.out" 2&gt;&gt; "$HOME/crawler/logs/launchd-wing.err"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
</dict>
</plist>
