<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  16GB 크롤링 맥 전용 — 매일 08:15 run-daily-rank.sh (실제 크롬을 AppleScript 로 조종해 네이버 쇼핑 순위 → 슬랙). 클로드 확장 안 씀.
  자동화 권한(osascript→Chrome)·Chrome 'Apple Events 의 JavaScript 허용' 이 먼저 (SETUP.md 5번째 절). 다른 크롤링과 크롬 잠금 공유.
  등록 (16GB 에서, 대표 확인 후):
    cp ~/crawler/dashboard/scripts/crawler-16gb/com.namucompany.crawler-naver-rank.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.namucompany.crawler-naver-rank.plist
  해제: launchctl bootout gui/$(id -u)/com.namucompany.crawler-naver-rank
  로그: ~/crawler/logs/run-rank.log · ~/crawler/logs/naver-rank-YYYY-MM-DD.log · ~/crawler/logs/launchd-rank.err
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.namucompany.crawler-naver-rank</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>"$HOME/crawler/dashboard/scripts/crawler-16gb/run-daily-rank.sh" &gt;&gt; "$HOME/crawler/logs/launchd-rank.out" 2&gt;&gt; "$HOME/crawler/logs/launchd-rank.err"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
</dict>
</plist>
