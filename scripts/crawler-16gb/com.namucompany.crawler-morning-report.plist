<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  16GB 크롤링 맥 전용 — 매일 09:05 run-morning-report.sh. 크롬 불필요(node 만) — 다른 크롤링 작업과 크롬 잠금을 안 쓴다.
  08:40(어제 광고)·08:50(재고)·08:55(네이버)가 먼저 끝나 있어야 알찬 보고서가 되지만, 안 끝나 있어도 그 칸만 '미수신'으로 돌아간다(막지 않음).
  등록 (16GB 에서, 대표 확인 후):
    cp ~/crawler/dashboard/scripts/crawler-16gb/com.namucompany.crawler-morning-report.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.namucompany.crawler-morning-report.plist
  해제: launchctl bootout gui/$(id -u)/com.namucompany.crawler-morning-report
  로그: ~/crawler/logs/run-morning.log · ~/crawler/logs/morning-report-YYYY-MM-DD.log · ~/crawler/logs/launchd-morning.err
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.namucompany.crawler-morning-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>"$HOME/crawler/dashboard/scripts/crawler-16gb/run-morning-report.sh" &gt;&gt; "$HOME/crawler/logs/launchd-morning.out" 2&gt;&gt; "$HOME/crawler/logs/launchd-morning.err"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>5</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
</dict>
</plist>
