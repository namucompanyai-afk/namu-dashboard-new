<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  16GB 크롤링 맥 전용 — 매일 08:50 run-daily-stock.sh (아침 보고서 09:05 전에 끝내려고 10:00→08:50 당김, 2026-10-22) (광고센터 "광고 만들기" 상품 목록 읽기 → 1P 재고·현재가 → 슬랙). 등록 안 함, 읽기만.
  다른 크롤링 작업(07:30 페이지 순회·08:15 네이버·08:45 윙 엑셀)과 크롬 잠금을 공유해 겹치면 순서대로.
  등록 (16GB 에서, 대표 확인 후):
    cp ~/crawler/dashboard/scripts/crawler-16gb/com.namucompany.crawler-adcenter-stock.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.namucompany.crawler-adcenter-stock.plist
  해제: launchctl bootout gui/$(id -u)/com.namucompany.crawler-adcenter-stock
  로그: ~/crawler/logs/run-stock.log (요약) · ~/crawler/logs/adcenter-stock-YYYY-MM-DD.log · ~/crawler/logs/launchd-stock.err
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.namucompany.crawler-adcenter-stock</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>"$HOME/crawler/dashboard/scripts/crawler-16gb/run-daily-stock.sh" &gt;&gt; "$HOME/crawler/logs/launchd-stock.out" 2&gt;&gt; "$HOME/crawler/logs/launchd-stock.err"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>50</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
</dict>
</plist>
